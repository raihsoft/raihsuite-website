# Required environment variables (do NOT commit .env with secrets)
TENANT_ID=example-tenant
RAISUITE_API_BASE=https://api.example.com
RAISUITE_API_KEY=REPLACE_ME
# Optional Turnstile secret for CAPTCHA (Cloudflare)
TURNSTILE_SECRET=

# ILU Foundation Page Variables (Cloudflare / Local)
NEXT_PUBLIC_BASE_API_URL=https://staging-api.raihsuite.com/v1/
NEXT_PUBLIC_ILU_TENANT_CODE=ILU001
NEXT_PUBLIC_ILU_FUNDRAISING_ID=01a12f6e-124f-76bc-aec1-315fc26ef222
NEXT_PUBLIC_ILU_TENANT_NAME=ILU
NEXT_PUBLIC_ILU_FUNDRAISING_NAME=ilu payasam-challenge-2026
NEXT_PUBLIC_ILU_FUNDRAISING_CODE=ILU041
# Optional explicit override for Tenant ID (defaults to automatic mapping from TENANT_CODE)
NEXT_PUBLIC_ILU_TENANT_ID=73

# ILU Volunteer Registration Program Variables (Cloudflare / Local)
NEXT_PUBLIC_ILU_VOLUNTEER_PROGRAM_ID=01a1b00a-394f-7991-bd86-342648b14fcc
NEXT_PUBLIC_ILU_VOLUNTEER_PROGRAM_CODE=ILUV001
# Optional: override volunteer API endpoint directly if not using default BASE_API_URL + programs/participants/
# NEXT_PUBLIC_ILU_VOLUNTEER_API_URL=https://staging-api.raihsuite.com/v1/programs/participants/